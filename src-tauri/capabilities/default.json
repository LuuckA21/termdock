{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window. Only the commands listed here can be invoked from the UI.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-app-info",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-set-favorite",
    "allow-reorder-favorites",
    "allow-forget-secrets",
    "allow-forget-host-key",
    "allow-list-shells",
    "allow-open-session",
    "allow-reconnect-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-close-session",
    "allow-answer-prompt",
    "allow-preview-ssh-config",
    "allow-import-ssh-config",
    "allow-session-log-start",
    "allow-session-log-stop",
    "allow-config-export",
    "allow-config-import-pick",
    "allow-config-import-apply",
    "allow-config-import-cancel",
    "allow-check-update",
    "allow-install-update",
    "allow-sftp-open",
    "allow-sftp-close",
    "allow-sftp-list",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-remove",
    "allow-sftp-cancel",
    "allow-sftp-pick-upload",
    "allow-sftp-pick-upload-folders",
    "allow-sftp-forget-picks",
    "allow-sftp-plan-upload",
    "allow-sftp-plan-download",
    "allow-sftp-run-plan",
    "allow-sftp-drop-plan",
    "allow-sftp-sudo-password",
    "allow-sftp-sudo-cancel",
    "allow-sftp-edit",
    "allow-sftp-edit-resolve",
    "allow-editor-get",
    "allow-editor-pick",
    "allow-editor-reset"
  ]
}
